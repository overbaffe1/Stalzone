# Copy to `.env` and fill in. NEVER commit `.env` (see .gitignore).
# Your approved EXBO application ("market_api"):
# (STALZONE_CLIENT_ID / STALZONE_CLIENT_SECRET / STALZONE_REGION also work)
STALCRAFT_CLIENT_ID=4682
STALCRAFT_CLIENT_SECRET=paste-your-secret-here
# Region of YOUR character's auction: RU / EU / NA / SEA
STALCRAFT_REGION=RU
# Production EAPI (demo: https://dapi.stalzone.com)
EAPI_BASE_URL=https://eapi.stalcraft.net
# Rate limits (official: 100 tokens/min, auction request = 2 tokens).
# Lower EAPI_MIN_GAP does NOT speed things up past the bucket — raise
# EAPI_TOKENS_PER_MIN only if you never see HTTP 429 (server may allow more).
EAPI_MIN_GAP=0.1
EAPI_TOKENS_PER_MIN=100
EAPI_AUCTION_COST=2
# Local SQLite database
MARKET_DB=data/market.db
